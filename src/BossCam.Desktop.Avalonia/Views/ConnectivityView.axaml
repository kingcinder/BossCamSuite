<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BossCam.Desktop.Avalonia.Controls"
             x:Class="BossCam.Desktop.Avalonia.Views.ConnectivityView">
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Connectivity" FontSize="18" FontWeight="Bold" Foreground="#fff"
                 VerticalAlignment="Center"
                 c:InfoExplainer.Title="Connectivity"
                 c:InfoExplainer.Explanation="Live health of every camera transport. Diagnose a camera to run a full connection diagnostic, or Reconnect to force the failover logic to recover it." />
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="⟳ Refresh"
              c:InfoExplainer.Title="Refresh"
              c:InfoExplainer.Explanation="Reloads the connectivity snapshots for all cameras." />
    </Grid>

    <Border Background="#20203a" CornerRadius="8" Padding="10">
      <StackPanel Spacing="4">
        <TextBlock Text="Snapshots" FontSize="14" FontWeight="Bold" Foreground="#ddd"
                   c:InfoExplainer.Title="Snapshots"
                   c:InfoExplainer.Explanation="Per-camera health from the connectivity watchdog: overall status, per-transport results, and the last diagnostic summary." />
        <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                 MaxHeight="200" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#23233f" CornerRadius="6" Padding="8,6" Margin="0,2">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"
                               Foreground="{Binding Status, Converter={x:Static c:ConnectivityBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding DeviceId}" FontSize="12" Foreground="#bbb"
                               TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <TextBlock Text="{Binding LastCheckedAt, StringFormat=HH:mm:ss}" FontSize="11"
                               Foreground="#7a7aa0" />
                  </StackPanel>
                  <TextBlock Text="{Binding LastDiagnosticSummary}" FontSize="11" Foreground="#8a8aa8"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Command="{Binding DiagnoseCommand}" Content="🔬 Diagnose"
              c:InfoExplainer.Title="Diagnose"
              c:InfoExplainer.Explanation="Runs a full connection diagnostic against the selected snapshot (or the selected camera): probes every transport and reports what works and what doesn't." />
      <Button Command="{Binding ReconnectCommand}" Content="🔌 Reconnect"
              c:InfoExplainer.Title="Reconnect"
              c:InfoExplainer.Explanation="Forces the failover logic to attempt a reconnect for the selected camera, re-resolving its best transport." />
    </StackPanel>

    <TextBlock Text="{Binding ResultText}" FontSize="12" Foreground="#9a9ab0" TextWrapping="Wrap"
               c:InfoExplainer.Title="Result"
               c:InfoExplainer.Explanation="Outcome of the last connectivity action." />
  </StackPanel>
</UserControl>
