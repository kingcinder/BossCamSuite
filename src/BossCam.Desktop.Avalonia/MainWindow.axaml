<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BossCam.Desktop.Avalonia.ViewModels"
        xmlns:views="clr-namespace:BossCam.Desktop.Avalonia.Views"
        xmlns:c="clr-namespace:BossCam.Desktop.Avalonia.Controls"
        x:Class="BossCam.Desktop.Avalonia.MainWindow"
        Title="BossCamSuite"
        Width="1280" Height="800"
        Background="#12121f"
        Foreground="#e8e8f0">

  <Grid RowDefinitions="Auto,*,Auto" Margin="8">

    <!-- ── Top toolbar ─────────────────────────────────────────── -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="🎥 BossCamSuite" FontSize="18" FontWeight="Bold" Foreground="#fff"
                   c:InfoExplainer.Explanation="BossCamSuite is the camera control platform. Every button and field in this window shows an explanation when you hover over it."
                   c:InfoExplainer.Title="Welcome to BossCamSuite" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Button Command="{Binding LoadDevicesCommand}" Content="📡 Load Devices"
                c:InfoExplainer.Title="Load Devices"
                c:InfoExplainer.Explanation="Fetches the list of registered cameras from the BossCamService. Press this after the service starts or after adding cameras." />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#9a9ab0"
                   FontSize="13" MaxWidth="520" TextTrimming="CharacterEllipsis"
                   c:InfoExplainer.Explanation="Status bar — the latest result of your last action (device loads, registrations, applies, recordings)." />
      </StackPanel>
    </Grid>

    <!-- ── Body: nav + devices + content ───────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="210,270,*" Margin="0,0,0,8">

      <!-- Left: section navigation -->
      <Border Background="#181830" CornerRadius="10" Padding="8">
        <StackPanel>
          <TextBlock Text="Sections" FontSize="12" Foreground="#7777a0" Margin="4,2,0,6"
                     c:InfoExplainer.Title="Navigation"
                     c:InfoExplainer.Explanation="Choose what you want to do: watch a camera live, manage devices, flip feature toggles, run recordings, or inspect diagnostics. Hover any entry for its description." />
          <ListBox ItemsSource="{Binding Sections}"
                   SelectedItem="{Binding SelectedSection}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4"
                            c:InfoExplainer.Explanation="{Binding Explain}"
                            c:InfoExplainer.Title="{Binding Title}">
                  <TextBlock Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Foreground="#ddd" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Middle: device list -->
      <Border Grid.Column="1" Background="#181830" CornerRadius="10" Padding="8" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Text="Cameras" FontSize="16" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"
                     c:InfoExplainer.Title="Camera list"
                     c:InfoExplainer.Explanation="Registered cameras on this BossCamSuite. Select one to make it the active camera for Live View, Features, Recordings and the other device sections." />
          <ListBox ItemsSource="{Binding Devices}"
                   SelectedItem="{Binding SelectedDevice}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#23233f" CornerRadius="6" Padding="8,6" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#eee"
                               FontSize="13" />
                    <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="#8a8aa8" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Right: active section content. Each section VM renders its own view
           via the DataTemplates collection below (matched by DataType). -->
      <Border Grid.Column="2" Background="#181830" CornerRadius="10" Padding="12" Margin="8,0,0,0">
        <ContentControl Content="{Binding SelectedSection}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:MainWindowViewModel}"><views:LiveView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FeaturesViewModel}"><views:FeaturesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordingsViewModel}"><views:RecordingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HighlightsViewModel}"><views:HighlightsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaybackViewModel}"><views:PlaybackView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FirmwareViewModel}"><views:FirmwareView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectivityViewModel}"><views:ConnectivityView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView /></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Grid>

    <!-- ── Status bar ──────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="#23233f" CornerRadius="6" Padding="8,5"
            c:InfoExplainer.Title="Status"
            c:InfoExplainer.Explanation="Bottom status strip — shows connection state and the outcome of the last action.">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#a0a0c0" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- ── Explainer overlay host (popup is hosted here, above content) ── -->
    <Panel Name="ExplainerHost" Grid.RowSpan="3" IsHitTestVisible="False" Background="Transparent" />
  </Grid>
</Window>
